generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TRAINER
  CUSTOMER
}

enum PlanCategory {
  SUBSCRIPTION
  PACKAGE
  ADDON
  TRIAL
  ENROLLMENT
}

enum BillingCadence {
  ONE_TIME
  MONTHLY
}

enum SessionCategory {
  PT_55
  PT_25
  TRIAL_90
  COUNSELING
  ENROLLMENT
}

enum CreditBucket {
  CURRENT
  NEXT
  IMMEDIATE
}

enum CreditLedgerEventType {
  PURCHASE_ALLOCATION
  MANUAL_ADJUSTMENT
  BOOKING_CONSUME
  BOOKING_RELEASE
  EXPIRATION
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Tenant {
  id                String     @id @default(cuid())
  name              String
  slug              String     @unique
  email             String?
  phone             String?
  demoBootstrappedAt DateTime?
  users             User[]
  locations         Location[]
  trainers          Trainer[]
  trainerShifts     TrainerShift[]
  customers         Customer[]
  plans             Plan[]
  planPurchases     PlanPurchase[]
  creditLedgerEntries CreditLedgerEntry[]
  bookings          Booking[]
  bookingLocks      BookingLock[]
  scheduleClosures  ScheduleClosure[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Location {
  id        String    @id @default(cuid())
  tenantId  String
  slug      String
  name      String
  timezone  String    @default("Asia/Tokyo")
  address   String?
  isActive  Boolean   @default(true)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  trainers  Trainer[]
  trainerShifts TrainerShift[]
  bookings  Booking[]
  closures  ScheduleClosure[]
  customers Customer[]
  admins    User[]    @relation("LocationAdmins")
  planPurchases       PlanPurchase[]
  creditLedgerEntries CreditLedgerEntry[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  tenantId          String?
  managedLocationId String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  managedLocation   Location? @relation("LocationAdmins", fields: [managedLocationId], references: [id])
  trainer           Trainer?
  customer          Customer?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Trainer {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String?   @unique
  locationId String?
  name       String
  email      String?
  bio        String?
  isActive   Boolean   @default(true)
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  location   Location? @relation(fields: [locationId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])
  shifts     TrainerShift[]
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model TrainerShift {
  id          String    @id @default(cuid())
  tenantId    String
  trainerId   String
  locationId  String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int       @default(1)
  memo        String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  trainer     Trainer   @relation(fields: [trainerId], references: [id])
  location    Location  @relation(fields: [locationId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id               String          @id @default(cuid())
  tenantId         String
  userId           String?         @unique
  supabaseId       String?         @unique
  stripeCustomerId String?         @unique
  firstName        String
  lastName         String
  email            String?
  locationId       String?
  phone            String?
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  location         Location?       @relation(fields: [locationId], references: [id])
  bookings         Booking[]
  purchases        PlanPurchase[]
  creditLedger     CreditLedgerEntry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, locationId])
}

model Plan {
  id                String                 @id @default(cuid())
  tenantId          String?
  name              String
  slug              String                 @unique
  description       String?
  category          PlanCategory
  billingCadence    BillingCadence
  sessionCategory   SessionCategory
  durationMinutes   Int
  stripeProductId   String?
  stripePriceId     String?
  baseCredits       Int                    @default(0)
  tenant            Tenant?                @relation(fields: [tenantId], references: [id])
  allocations       PlanCreditAllocation[]
  purchases         PlanPurchase[]
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model PlanCreditAllocation {
  id              String          @id @default(cuid())
  planId          String
  bucket          CreditBucket
  creditType      SessionCategory
  quantity        Int
  effectiveDay    Int?            // optional day override for allocation (e.g. 22日)
  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([planId, creditType])
}

model PlanPurchase {
  id                   String                @id @default(cuid())
  tenantId             String
  customerId           String
  planId               String
  locationId           String
  billingCadence       BillingCadence
  status               String                @default("active")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  nextBillingAt        DateTime?
  stripeSubscriptionId String?
  stripePriceId        String?
  metadata             Json?
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  customer             Customer              @relation(fields: [customerId], references: [id])
  plan                 Plan                  @relation(fields: [planId], references: [id])
  location             Location              @relation(fields: [locationId], references: [id])
  ledgerEntries        CreditLedgerEntry[]
  bookings             Booking[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([tenantId, customerId, locationId])
  @@index([stripeSubscriptionId])
}

model CreditLedgerEntry {
  id              String                @id @default(cuid())
  tenantId        String
  customerId      String
  planPurchaseId  String?
  bookingId       String?
  locationId      String
  bucket          CreditBucket
  creditType      SessionCategory
  quantity        Int
  eventType       CreditLedgerEventType
  occurredAt      DateTime              @default(now())
  memo            String?
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  customer        Customer              @relation(fields: [customerId], references: [id])
  planPurchase    PlanPurchase?         @relation(fields: [planPurchaseId], references: [id])
  booking         Booking?              @relation(fields: [bookingId], references: [id])
  location        Location              @relation(fields: [locationId], references: [id])
  createdAt       DateTime              @default(now())

  @@index([tenantId, customerId, locationId, occurredAt])
  @@index([bookingId])
}

model Booking {
  id                 String           @id @default(cuid())
  tenantId           String
  locationId         String
  customerId         String
  trainerId          String?
  planPurchaseId     String?
  creditType         SessionCategory
  startsAt           DateTime
  endsAt             DateTime
  status             BookingStatus     @default(BOOKED)
  allowTrainerChoice Boolean           @default(true)
  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  location           Location         @relation(fields: [locationId], references: [id])
  trainer            Trainer?         @relation(fields: [trainerId], references: [id])
  customer           Customer         @relation(fields: [customerId], references: [id])
  planPurchase       PlanPurchase?    @relation(fields: [planPurchaseId], references: [id])
  lock               BookingLock?     @relation("BookingLockToBooking")
  ledgerEntries      CreditLedgerEntry[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId, startsAt])
  @@index([customerId, startsAt])
}

model BookingLock {
  id         String    @id @default(cuid())
  tenantId   String
  bookingId  String
  lockedBy   String
  lockedAt   DateTime  @default(now())
  expiresAt  DateTime
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  booking    Booking   @relation("BookingLockToBooking", fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId])
}

model ScheduleClosure {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, startsAt, endsAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
