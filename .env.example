# Supabase connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma database connection (Supabase Postgres)
# 例: postgresql://user:pass@host:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL=
# 例: postgresql://user:pass@host:5432/postgres?sslmode=require
DIRECT_URL=

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Stripe keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUR_55=

# Application
APP_TENANT_SLUG=light-fit
DEMO_TENANT_EMAIL=tenant-admin@example.com
DEMO_TENANT_PASSWORD=change-me
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=customer-pass
DEMO_CUSTOMER_FIRST_NAME=太郎
DEMO_CUSTOMER_LAST_NAME=予約
# 任意: 表示名を固定したい場合に利用
DEMO_CUSTOMER_DISPLAY_NAME=
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=tenant-admin@example.com
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=customer@example.com

